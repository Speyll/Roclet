-/* FREE SPACE OCCUPIED BY A SPARSE MOD2 MATRIX. */
-
-void of_mod2sparse_free (of_mod2sparse	*m)				/* Matrix to free */
-{
-	//OF_ENTER_FUNCTION
-	of_mod2block *b;
-
-	of_free (m->rows);
-	of_free (m->cols);
-
-	while (m->blocks != 0)
-	{
-		b = m->blocks;
-		m->blocks = b->next;
-		of_free (b);
-	}
-	//OF_EXIT_FUNCTION
-}
