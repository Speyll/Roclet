-	of_mod2block *b;
-	of_mod2entry *e;
-	INT32 i, j;
-
-	OF_ENTER_FUNCTION
-	for (i = 0; i < of_mod2sparse_rows (r); i++)
-	{
-		e = &r->rows[i];
-#ifndef SPARSE_MATRIX_OPT_FOR_LDPC_STAIRCASE
-		e->left = e->right = e->up = e->down = e;
-#else
-		e->left = e->right = e->down = e;
-#endif
-	}
-
-	for (j = 0; j < of_mod2sparse_cols (r); j++)
