-		return;
-	}
-
-	of_mod2dense_clear (r);
-
-	for (i = 0; i < of_mod2sparse_rows (m); i++)
-	{
-		e = of_mod2sparse_first_in_row (m, i);
-		while (!of_mod2sparse_at_end (e))
-		{
-			of_mod2dense_set (r, i, of_mod2sparse_col (e), 1);
-			e = of_mod2sparse_next_in_row (e);
-		}
-	}
-}
